# =============================================================================
# GridXray configuration
#
# 1. Copy this file to backend/.env:     cp .env.example backend/.env
# 2. Paste your Meta Model API key below (the only required value).
# 3. Check access:                       docker compose run --rm api gridxray ping
#
# backend/.env is git-ignored. Never commit your real key.
# =============================================================================

# --- Meta Model API key (REQUIRED) -------------------------------------------
# Create one in the Meta Model API dashboard: https://dev.meta.ai/
# Docs: https://dev.meta.ai/docs/quickstart#api-key
# Paste it right after the "=" with no quotes or spaces, e.g. META_API_KEY=abc123...
# (MODEL_API_KEY, the name used in Meta's docs, also works.)
META_API_KEY=

# --- Models (optional: defaults shown) ---------------------------------------
# Muse Spark: lead investigator (fast tool loops). Muse Wonder: second-opinion reviewer.
# META_API_BASE_URL=https://api.meta.ai/v1
# SPARK_MODEL=muse-spark-1.3
# WONDER_MODEL=muse-wonder-1.0
# Reasoning effort: minimal | low | medium | high | xhigh | max
# SPARK_REASONING_EFFORT=medium
# WONDER_REASONING_EFFORT=high

# --- Investigation limits (optional) -----------------------------------------
EXPERIMENT_BUDGET=20
MAX_AGENT_STEPS=60
MAX_WONDER_REVIEWS=3
